# Copy to .env and fill in. Never commit .env.

# Data (defaults: cases.xlsx, falling back to cases.csv)
# CASES_FILE=cases.xlsx
FIRM_NAME=Example Immigration Law Group

# SMTP — only needed to actually send email (python run_daily.py --no-dry-run)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=alerts@yourfirm.com
SMTP_PASSWORD=
SMTP_FROM=Deadline Tracker <alerts@yourfirm.com>
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# Testing/demos: send EVERY alert email to this one address instead of the attorneys.
# Leave blank to email the attorneys normally.
REDIRECT_ALL_EMAILS_TO=

# Optional: Claude writes the intro paragraph of each attorney email.
# Leave blank to use the built-in template.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Output locations (defaults shown)
# OUTPUT_DIR=output
# LOG_FILE=logs/tracker.log
